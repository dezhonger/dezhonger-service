server {
  listen 80;
  listen [::]:80;
  server_name knowledge.${PUBLIC_DOMAIN} docs.${PUBLIC_DOMAIN} guwen.${PUBLIC_DOMAIN}
              zmq.${PUBLIC_DOMAIN} rby.${PUBLIC_DOMAIN} math.${PUBLIC_DOMAIN} algo.${PUBLIC_DOMAIN}
              english.${PUBLIC_DOMAIN} biology.${PUBLIC_DOMAIN} geography.${PUBLIC_DOMAIN}
              physics.${PUBLIC_DOMAIN} chemistry.${PUBLIC_DOMAIN} history.${PUBLIC_DOMAIN}
              puzzle.${PUBLIC_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
    try_files $uri =404;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name docs.${PUBLIC_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${CONTENT_CERT_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${CONTENT_CERT_NAME}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  add_header Strict-Transport-Security "max-age=31536000" always;
  return 301 https://knowledge.${PUBLIC_DOMAIN}$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name knowledge.${PUBLIC_DOMAIN} guwen.${PUBLIC_DOMAIN}
              rby.${PUBLIC_DOMAIN} math.${PUBLIC_DOMAIN} algo.${PUBLIC_DOMAIN}
              english.${PUBLIC_DOMAIN} biology.${PUBLIC_DOMAIN} geography.${PUBLIC_DOMAIN}
              physics.${PUBLIC_DOMAIN} chemistry.${PUBLIC_DOMAIN} history.${PUBLIC_DOMAIN}
              puzzle.${PUBLIC_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${CONTENT_CERT_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${CONTENT_CERT_NAME}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:CONTENT_SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location / {
    proxy_pass http://knowledge;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# The family blog uses same-origin API access. Other content sites remain static.
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name zmq.${PUBLIC_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${CONTENT_CERT_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${CONTENT_CERT_NAME}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_tickets off;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy same-origin always;
  add_header Cache-Control "private, no-store, max-age=0" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_hide_header Cache-Control;
  limit_req_status 429;

  location = /api/auth/login {
    limit_req zone=auth burst=5 nodelay;
    proxy_pass http://api:8080;
  }

  location = /api/auth/me {
    proxy_pass http://api:8080;
  }

  location = /api/auth/logout {
    proxy_pass http://api:8080;
  }

  location ~ ^/api/blog/posts/[a-fA-F0-9-]+/unlock$ {
    limit_req zone=blog_unlock burst=5 nodelay;
    proxy_pass http://api:8080;
  }

  location ~ ^/api/blog/admin/posts/[a-fA-F0-9-]+/media$ {
    client_max_body_size 210m;
    client_body_timeout 900s;
    proxy_request_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_pass http://api:8080;
  }

  location /api/blog/ {
    proxy_buffering off;
    proxy_read_timeout 900s;
    send_timeout 900s;
    proxy_pass http://api:8080;
  }

  location /api/ {
    return 404;
  }

  location / {
    proxy_pass http://knowledge;
  }
}
